{
  "name": "quotacap",
  "version": "0.0.27",
  "description": "Local quota tracker for AI coding plans with a dashboard, CLI, MCP server, and next-plan recommendations.",
  "license": "MIT",
  "keywords": [
    "ai-coding",
    "cli",
    "mcp",
    "quota-tracker",
    "usage-limits",
    "usage-tracker",
    "claude-code",
    "codex",
    "kimi-code",
    "grok",
    "antigravity",
    "agy"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosboeing/quotacap.git"
  },
  "bugs": {
    "url": "https://github.com/carlosboeing/quotacap/issues"
  },
  "bin": {
    "quotacap": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "!dist/src/",
    "web/dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && node scripts/build-embed.mjs && tsc && cp -R dist/src/* dist/ && chmod +x dist/cli/index.js",
    "build:bin": "node scripts/build-binary.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:smoke": "playwright test -c tests/smoke/playwright.config.ts",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.0.0",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^1.6.0"
  }
}
