{
  "name": "quotacap",
  "version": "0.0.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosboeing/quotacap.git"
  },
  "bin": {
    "quotacap": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && node scripts/build-embed.mjs && tsc && cp -R dist/src/* dist/ && chmod +x dist/cli/index.js",
    "build:bin": "node scripts/build-binary.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.0.0",
    "fastify": "^5.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.19",
    "vitest": "^1.6.0"
  }
}
